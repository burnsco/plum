{
  "name": "@plum/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "tsc -b && vite build",
    "lint": "oxlint --config .oxlintrc.json --deny-warnings --report-unused-disable-directives src vite.config.ts",
    "lint:fix": "oxlint --config .oxlintrc.json --fix src vite.config.ts",
    "tailwind:lint": "tailwind-lint --config ./src/index.css",
    "tailwind:fix": "tailwind-lint --config ./src/index.css --fix",
    "format": "oxfmt --config .oxfmtrc.json --write package.json .oxlintrc.json .oxfmtrc.json src vite.config.ts",
    "format:check": "oxfmt --config .oxfmtrc.json --check package.json .oxlintrc.json .oxfmtrc.json src vite.config.ts",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "test": "NODE_OPTIONS='--no-experimental-webstorage' vitest run",
    "test:app": "NODE_OPTIONS='--no-experimental-webstorage' vitest run src/App.test.tsx",
    "test:stable": "NODE_OPTIONS='--no-experimental-webstorage' vitest run --exclude '**/App.test.tsx'",
    "test:watch": "NODE_OPTIONS='--no-experimental-webstorage' vitest"
  },
  "dependencies": {
    "@plum/contracts": "workspace:*",
    "@plum/shared": "workspace:*",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-slider": "^1.4.3",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "effect": "4.0.0-beta.78",
    "hls.js": "^1.6.16",
    "jassub": "^2.5.6",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "postcss": "^8.5.16",
    "tailwind-lint": "^0.12.0",
    "tailwindcss": "^4.3.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
