{
  "name": "@plum/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "bunx oxlint --config ../../.oxlintrc.json --deny-warnings --report-unused-disable-directives src",
    "lint:fix": "bunx oxlint --config ../../.oxlintrc.json --fix src",
    "format": "bunx oxfmt --config ../../.oxfmtrc.json --write package.json src",
    "format:check": "bunx oxfmt --config ../../.oxfmtrc.json --check package.json src"
  },
  "dependencies": {
    "@plum/contracts": "workspace:*",
    "effect": "4.0.0-beta.78"
  },
  "devDependencies": {
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^6.0.3"
  }
}
