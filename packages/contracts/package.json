{
  "name": "@plum/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate:json-schema": "bun run scripts/generate-cross-platform-json-schema.ts",
    "typecheck": "tsc --noEmit",
    "lint": "bunx oxlint --config ../../.oxlintrc.json --deny-warnings --report-unused-disable-directives src scripts",
    "lint:fix": "bunx oxlint --config ../../.oxlintrc.json --fix src scripts",
    "format": "bunx oxfmt --config ../../.oxfmtrc.json --write package.json src scripts",
    "format:check": "bunx oxfmt --config ../../.oxfmtrc.json --check package.json src scripts"
  },
  "dependencies": {
    "effect": "4.0.0-beta.52"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^6.0.3"
  }
}
